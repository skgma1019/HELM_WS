# 로봇 인증 토큰. /ws/robot 접속, POST /api/events 등에서 요구한다. 실제 배포 시 반드시 바꿀 것
HELM_ROBOT_TOKEN=helm-dev-token

# 개발용 테스트 콘솔(static/test.html, /api/dev/samples 등)을 서빙할지 여부. 1=켜짐. EC2 운영 배포에선 절대 켜면 안 됨
HELM_DEV=1

# DB(helm.db)·지도·스냅샷·샘플 사진을 저장할 폴더 (저장소 루트 기준 상대경로 또는 절대경로)
HELM_DATA_DIR=data

# severity 산정 임계값. 실측 전 임시값 — 현장 데이터로 나중에 조정한다
# ratio = vision.score / vision.threshold. 1.0 이상이면 caution, 아래 값 이상이면 danger
HELM_SEVERITY_RATIO_CAUTION=1.0
HELM_SEVERITY_RATIO_DANGER=1.3
# thermal.max_temp_c가 thermal.threshold_c를 이 값(°C) 이상 초과하면 danger
HELM_THERMAL_OVERSHOOT_DANGER_C=10.0
